#!/usr/bin/with-contenv bash

# Docker preserves the host group IDs on mapped DRM devices. Add the service
# user to those numeric groups at startup so AMD VAAPI and Intel QSV work even
# when the host's video/render GIDs differ from the image.
for gpu_device in /dev/dri/renderD* /dev/dri/card*; do
    [[ -e "${gpu_device}" ]] || continue
    gpu_gid="$(stat -c '%g' "${gpu_device}")"
    [[ "${gpu_gid}" != "0" ]] || continue
    gpu_group="$(getent group "${gpu_gid}" | cut -d: -f1)"
    if [[ -z "${gpu_group}" ]]; then
        gpu_group="tater-gpu-${gpu_gid}"
        groupadd --gid "${gpu_gid}" "${gpu_group}"
    fi
    usermod --append --groups "${gpu_group}" abc
done

# NVIDIA's injected Vulkan ICD normally points at the GLX implementation. That
# implementation cannot expose Vulkan in some headless containers even though
# NVENC and the rest of the driver are available. NVIDIA also supports its EGL
# implementation as a Vulkan ICD for headless environments, so create a private
# copy for the server when the runtime has injected that library. Keep explicit
# user Vulkan driver selections untouched and leave Intel/AMD containers alone.
nvidia_icd="/etc/vulkan/icd.d/nvidia_icd.json"
if [[ -z "${VK_DRIVER_FILES:-}" && -z "${VK_ICD_FILENAMES:-}" && -r "${nvidia_icd}" ]] && \
    ldconfig -p 2>/dev/null | grep -Fq 'libEGL_nvidia.so.0'; then
    vulkan_runtime_dir="/run/tater-tube-server/vulkan"
    nvidia_egl_icd="${vulkan_runtime_dir}/nvidia_egl_icd.json"
    install -d -m 0755 "${vulkan_runtime_dir}"
    sed 's/libGLX_nvidia\.so\.0/libEGL_nvidia.so.0/g' "${nvidia_icd}" > "${nvidia_egl_icd}"
    if grep -Fq 'libEGL_nvidia.so.0' "${nvidia_egl_icd}"; then
        export VK_DRIVER_FILES="${nvidia_egl_icd}"
        export NODEVICE_SELECT=1
        echo "Tater Tube: using the NVIDIA EGL Vulkan driver for headless processing"
    else
        rm -f "${nvidia_egl_icd}"
    fi
fi

# Keep libplacebo's compiled AI shaders on the persistent /config volume so
# subsequent streams and container updates can reuse them.
export TATER_AI_SHADER_CACHE_DIR="${TATER_AI_SHADER_CACHE_DIR:-/config/cache/libplacebo/v1}"

exec s6-setuidgid abc /app/tater-tube-server serve --config=/config/config.yaml
